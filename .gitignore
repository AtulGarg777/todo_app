# ----------------------------------------------------------------------------
# MERN Stack Project .gitignore Template
# ----------------------------------------------------------------------------

# Dependency folders (Massive directories downloaded via npm/yarn)
node_modules/
**/node_modules/
jspm_packages/
.npm/
.eslintcache

# Environment Variables & Secrets (CRITICAL: Never commit API keys or database URIs)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
config.env
server/config/config.env

# Production Build Directories (Generated on deployment)
build/
dist/
out/
.next/
client/build/
client/dist/

# Logs and Runtime Diagnostics
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids
*.pid
*.seed
*.pid.lock

# Local Testing and Code Coverage
coverage/
.nyc_output/
*.lcov

# IDEs, Editors, and OS-Specific Files
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# Local Database/Docker artifacts (if running MongoDB locally or in Docker)
.mongo-data/
server/docker/mongo-data/
